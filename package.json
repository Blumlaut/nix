{
  "name": "nix-scoreboard",
  "version": "1.0.0",
  "private": true,
  "description": "Scoreboard for the company 'nix' game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "vite build --config web/vite.config.mjs",
    "dev": "concurrently -k \"node server.js\" \"vite --config web/vite.config.mjs\"",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test e2e/*.test.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "better-sqlite3": "^12.11.1",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "vite": "^6.1.0"
  }
}
