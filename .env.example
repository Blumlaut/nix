# Discord application (Developer Portal -> Applications -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Server
PORT=8080
HOST=127.0.0.1
BASE_URL=https://nix.zap.cloud

# Long random string for session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional: override DB location (default: ./data/nix.sqlite)
# DB_PATH=/opt/nix/data/nix.sqlite
